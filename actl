#!/usr/bin/env bash
# Run an Ansible command inside the control-node container.
#
#   ./actl ansible -m ping vivostick
#   ./actl ansible-playbook site.yml --check --diff
#   ./actl ansible-playbook fetch-results.yml -e run_matrix=true
#   ./actl ./scripts/make-testclip.sh
#   ./actl bash                      # poke around
#
# Wraps `docker compose run` so UID/GID are exported and the image is built on
# first use. Everything lands in the mounted repo owned by you.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

# Not UID/GID: bash makes UID readonly, so exporting it aborts under set -e.
export HOST_UID="$(id -u)" HOST_GID="$(id -g)"

if [ -z "${SSH_AUTH_SOCK:-}" ]; then
  echo "warning: no SSH agent detected. Key-based auth will rely on the" >&2
  echo "         read-only ~/.ssh mount, which cannot prompt for a passphrase." >&2
fi

# Build once; Docker caches thereafter.
if ! docker image inspect uxplay-atom-ansible >/dev/null 2>&1; then
  echo "==> building the control-node image (first run only)"
  docker compose build ansible
fi

if [ $# -eq 0 ]; then
  set -- "ansible-playbook --syntax-check site.yml fetch-results.yml && echo OK"
fi

# Rootless Docker inverts the ownership problem this script exists to solve.
#
# Rootful: the daemon runs as root, container UID n == host UID n, so the image
# builds a user matching yours and files written into /work come back yours.
#
# Rootless: the daemon runs as you, and the namespace maps container UID 0 to
# your host UID -- everything else in the container goes to a subuid with no
# claim on your files. So the matched-UID user is precisely the one that CANNOT
# write to the mounted repo: `ansible-vault create`, make-testclip.sh and
# fetch-results' fetch into results/ all fail with "not writable" or
# "Permission denied". Running as container root is what maps back to you.
#
# Both cases therefore want "the user that owns your files", and which UID that
# is depends on the daemon, so ask it.
run_as=()
if docker info --format '{{.SecurityOptions}}' 2>/dev/null | grep -q 'name=rootless'; then
  run_as=(--user root)
fi

# The entrypoint is `bash -lc`, so pass the command as a single string.
exec docker compose run --rm "${run_as[@]}" ansible "$*"
