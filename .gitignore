# Probe output fetched back from the device
results/

# Generated test clips (large; rebuild with scripts/make-testclip.sh)
roles/probe/files/*.h264

# The vault password itself. The vault FILE is meant to be committed --
# host_vars/vivostick/vault.yml is encrypted -- but the key to it is not.
.vault-pass

# Site-specific values: addresses, the login, the share name. Plaintext and
# unpublished, which is why secrets do NOT go here -- those belong in the
# encrypted vault above, which IS committed. The pattern deliberately does not
# match local.yml.example, the committed template.
host_vars/*/local.yml
host_vars/*/vault.yml

*.retry
__pycache__/
*.pyc
