# Probe output fetched back from the device
results/

# Generated test clips (large; rebuild with scripts/make-testclip.sh)
roles/probe/files/*.h264

# The vault password itself. The vault FILE is meant to be committed --
# host_vars/vivostick/vault.yml is encrypted -- but the key to it is not.
.vault-pass

# Site-specific values: addresses, the login, the share name. Plaintext and
# unpublished, which is why secrets do NOT go here -- those belong in the
# vault below, which is encrypted. The pattern deliberately does not match
# local.yml.example, the committed template.
host_vars/*/local.yml

# The vault. Encrypted, so committing it would be defensible -- ansible-vault
# is AES-256 and the whole point of it is that the ciphertext can live in git.
# Kept out anyway, which has one consequence worth knowing: nothing backs this
# file up. Lose the working copy and the NAS credentials go with it, and no
# clone of this repo has them. Copy it somewhere safe.
host_vars/*/vault.yml

*.retry
__pycache__/
*.pyc
