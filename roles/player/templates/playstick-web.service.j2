{{ ansible_managed | comment }}
# The movie player: a web UI on the LAN and the arbiter that decides who owns
# the display. See the header of /usr/local/lib/playstick/__init__.py for why
# the arbitration lives in the daemon rather than in Conflicts= directives.
#
# There used to be forty-five Environment= lines here. They are one file now --
# /etc/playstick/settings.toml, rendered from settings.toml.j2 out of
# group_vars/all.yml, which is where a value is changed. What is left below is
# only what systemd itself needs: how to run the process and what to confine it
# to. The daemon's own configuration is not systemd's business.
#
# Not ordered After= the NAS automount on purpose. RequiresMountsFor= or a
# dependency on the .mount unit sounds right and defeats the point of the
# automount: it forces a real mount at unit start, so a NAS that is switched
# off turns "no films tonight" into "the player service failed to start". The
# daemon treats an unreachable share as a state to report, not a reason to die
# -- and now as something it can offer to switch back on.

[Unit]
Description=Playstick movie player (web UI and display arbiter)
Documentation=file:///usr/local/lib/playstick/__init__.py
After=network-online.target {{ player_airplay_unit | trim }}
Wants=network-online.target

[Service]
Type=simple
User={{ player_user }}

# Holds the mpv IPC socket, the busy flag the idle clock watches, and the
# record of which unit we took the display from. Preserved across a restart of
# this service so a crashed daemon can still work out what it owes.
RuntimeDirectory=playstick
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# The only environment variable the package reads. Everything else the daemon
# needs is in the file it names.
Environment=PLAYSTICK_SETTINGS=/etc/playstick/settings.toml

{# Pinned for the same reason it is pinned on the UxPlay unit: iHD does not
   cover Gen8 LP, and libva autodetection will find it anyway. This one stays
   an Environment= line because it is read by libva inside mpv, not by the
   daemon -- it is not a Playstick setting and does not belong in its file. #}
Environment=LIBVA_DRIVER_NAME={{ libva_driver }}

ExecStart=/usr/local/bin/playstick-web.py

# Belt and braces for the case the daemon never gets to run its own teardown:
# if it was killed between stopping the AirPlay receiver and starting it back,
# the marker file is still there and this puts the projector right.
ExecStopPost=-/bin/sh -c 'if [ -e {{ player_restore_file }} ]; then /bin/systemctl start {{ player_airplay_unit | trim }}; rm -f {{ player_restore_file }}; fi; rm -f {{ idle_busy_file }}'

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=2
# mpv is a child of this daemon, so it goes down with it. Without this a
# killed daemon would leave a film playing that nothing could stop.
KillMode=control-group
TimeoutStopSec=20

# ProtectSystem=full rather than strict: strict remounts the whole hierarchy
# read-only inside the service's mount namespace, and this service has to be
# able to see the CIFS automount trigger and the mount that appears under it.
# full gets the part that matters -- /usr and /etc read-only -- without that
# question. The real control on this daemon is not the sandbox, it is that no
# filesystem path ever crosses the HTTP boundary; see the module header.
#
# /etc read-only is what the settings file wants anyway: the daemon reads it
# once at import and never writes it.
ProtectSystem=full
ProtectHome=yes
NoNewPrivileges=yes
ReadWritePaths={{ player_thumb_dir }}
# AF_NETLINK is not optional and its absence fails in the dangerous direction:
# ss reads NETLINK_SOCK_DIAG, and without it the AirPlay gate would silently
# answer "nobody is mirroring" and take the display out from under a session.
#
# AF_INET carries the NAS wake-on-LAN broadcast as well as the web server. No
# DeviceAllow= is needed for the serial port the projector is on: this unit
# runs as root (mpv needs DRM master; the arbiter needs systemctl) and
# ProtectSystem=full does not touch /dev, with no PrivateDevices=. If
# PrivateDevices=yes is ever added, DeviceAllow=char-ttyUSB rw becomes
# necessary and its absence presents as "the projector never answers" --
# indistinguishable from the wrong cable, which is the failure this comment
# exists to prevent somebody debugging twice.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
