# The movie player's web UI, on a development machine.
#
#   docker compose up gui     ->  http://localhost:8080/  (port 80 inside)
#
# This is a second image with a different job from the Dockerfile next to it:
# that one is the Ansible control node, this one runs the thing Ansible would
# have installed. It exists so that the daemon under src/server/ and the built
# page under src/player/dist/ can be iterated on without a VivoStick, a
# projector or a NAS in the loop.
#
# WHAT IT TESTS FAITHFULLY
#
# The daemon and the page are the repository's own files, unmodified -- compose
# bind-mounts them over the copies baked in here, so editing the HTML and
# reloading the browser is the whole cycle. mpv is real, so the library scan,
# clean_title(), the poster pipeline, the play/pause/stop state machine, the
# progress bar and the AirPlay interlock all behave exactly as they do on the
# device.
#
# WHAT IT CANNOT TELL YOU
#
# Anything about the display, which is most of what makes this project hard.
# A container has no DRM node, no tty1, no VA-API and no systemd, so --vo=drm,
# --drm-mode, the DRM-master arbitration against uxplay-kms.service and every
# performance number in the README stay device-only questions. mpv runs with
# --vo=null here: the film is decoded and paced in real time and nothing is
# drawn. Absent systemctl, unit_active() answers false, so the daemon correctly
# decides it has no receiver to stop and none to restore -- the same path an
# operator running neither UxPlay unit takes on the real box.
FROM python:3.13-slim

# mpv does the decoding, the frame extraction and the IPC channel, exactly as
# on the device -- and ffmpeg, which is not installed there for want of eMMC,
# is here to generate the sample library. iproute2 is ss, for the AirPlay gate.
RUN apt-get update && apt-get install --no-install-recommends -y \
        mpv \
        ffmpeg \
        iproute2 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY src/server/playstick/ /usr/local/lib/playstick/
COPY src/server/playstick-web.py /usr/local/bin/playstick-web.py
COPY src/player/dist/playstick-ui.html /usr/local/share/playstick/ui.html
COPY scripts/gui-entrypoint.sh /usr/local/bin/playstick-gui-entrypoint
COPY scripts/gui-fake-airplay.py /usr/local/bin/fake-airplay
RUN chmod 0755 /usr/local/bin/playstick-gui-entrypoint \
               /usr/local/bin/fake-airplay

# The daemon reads one file, and playstick-gui-entrypoint writes it at startup
# -- see the heredoc there, where each deviation from the appliance is
# annotated next to the value that causes it. It is written at run time rather
# than baked here because the knobs a developer actually turns
# (PLAYSTICK_GUI_PROJECTOR, PLAYSTICK_GUI_NAS, ...) are environment variables
# on `make gui`, and a file baked into an image cannot read them.
ENV PLAYSTICK_SETTINGS=/etc/playstick/settings.toml

# Runs as root, as on the appliance (player_user: root) though for far less
# reason: nothing here needs DRM master or systemctl. It keeps /run/playstick
# and the poster cache writable without inventing an account, and the only
# host-visible path is the library, which the daemon never writes to.
# 80 inside, matching player_port on the device. The container runs as root so
# the low port binds; compose still publishes it on 8080 by default, because a
# host port below 1024 is refused outright under rootless Docker.
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:80/healthz', timeout=3)"

ENTRYPOINT ["/usr/local/bin/playstick-gui-entrypoint"]
# python3 rather than executing the file: compose bind-mounts it from the repo,
# where it is 0644 -- the executable bit comes from the ansible copy, not git.
CMD ["python3", "/usr/local/bin/playstick-web.py"]
